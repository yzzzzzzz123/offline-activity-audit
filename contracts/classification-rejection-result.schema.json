{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ZIP-name classification rejection without AI evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "decision_source", "generated_at", "summary", "archives"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "classification_rejection"},
    "decision_source": {"const": "zip_filename"},
    "generated_at": {"type": "string", "format": "date-time"},
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["conclusion"], "properties": {"conclusion": {"const": "rejected"}}
    },
    "archives": {
      "type": "array", "minItems": 1, "maxItems": 10,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["archive_id", "source_archive", "archive_sha256", "scenario", "reason_code", "matched_scenarios", "reason", "action"],
        "properties": {
          "archive_id": {"type": "string", "minLength": 1},
          "source_archive": {"type": "string", "minLength": 1},
          "archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "scenario": {"type": "null"},
          "reason_code": {"enum": ["missing_scenario_marker", "ambiguous_scenario_markers"]},
          "matched_scenarios": {
            "type": "array", "uniqueItems": true,
            "items": {"enum": ["personnel_incentive", "promotional_display", "poster_material", "other_expense", "maintenance_fee", "giveaway_promotion", "price_difference_support", "pos_target_incentive", "entry_fee", "self_procured_gift_material"]}
          },
          "reason": {"type": "string", "minLength": 1},
          "action": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {"if": {"properties": {"reason_code": {"const": "missing_scenario_marker"}}},
           "then": {"properties": {"matched_scenarios": {"maxItems": 0}}}},
          {"if": {"properties": {"reason_code": {"const": "ambiguous_scenario_markers"}}},
           "then": {"properties": {"matched_scenarios": {"minItems": 2}}}}
        ]
      }
    }
  }
}
