# 后端服务：仅使用实际内网或 loopback 地址，不填 0.0.0.0。
OFFLINE_AUDIT_BIND_HOST=127.0.0.1
OFFLINE_AUDIT_PORT=8080
OFFLINE_AUDIT_WORKBENCH_URL=http://127.0.0.1:8080/
# 同机 HTTPS 反向代理的页面来源；仅填 scheme://host[:port]，不含 /ai/ 等路径。
# 不使用反向代理时留空。原有操作 Token 校验仍然生效。
OFFLINE_AUDIT_PROXY_ORIGIN=

# 阿里云 RDS MySQL 8.x：内网连接地址、专用库和只读账号。
OFFLINE_AUDIT_PRODUCT_DB_HOST=replace-with-rds-internal-endpoint
OFFLINE_AUDIT_PRODUCT_DB_PORT=3306
OFFLINE_AUDIT_PRODUCT_DB_NAME=product_catalog
OFFLINE_AUDIT_PRODUCT_DB_USER=product_viewer
OFFLINE_AUDIT_PRODUCT_DB_PASSWORD_FILE=config/secrets/rds_password.txt
# 默认校验 CA 和主机名。仅在目标环境明确使用无 SSL 的连接时显式设为 DISABLED。
OFFLINE_AUDIT_PRODUCT_DB_SSL_MODE=VERIFY_IDENTITY
OFFLINE_AUDIT_PRODUCT_DB_CA_FILE=config/rds-ca.pem

# 模型：默认 PPIO；百炼可在工作台中测试并切换。文件中只填写对应平台的 Key。
PPIO_API_KEY_FILE=config/secrets/ppio_api_key.txt
DASHSCOPE_API_KEY_FILE=config/secrets/dashscope_api_key.txt

# 商品参考图：与业务 ZIP 的预签名 downloadUrl 分开配置。
OFFLINE_AUDIT_PRODUCT_OSS_CREDENTIALS_FILE=config/secrets/product-oss.json

# 可选：勤策核销、申请、终端、商品及陈列只读查询，私有 JSON 内为 host / openid / appkey。
# 未配置时保持原核销流程，不新增资料要求；不要把真实值写入此示例文件。
OFFLINE_AUDIT_QINCE_CREDENTIALS_FILE=
# 可选的额外 HTTPS 图片主机名，逗号分隔，仅443端口。
# 已配置的勤策API主机及勤策图片域名无需填写。
OFFLINE_AUDIT_QINCE_IMAGE_HOSTS=

# 业务接口：先保持接收关闭，完成配置和验收后改为 1。
OFFLINE_AUDIT_OSS_ENABLED=0
# 同时核销的单据数，仅允许 1 或 2；默认 1，参半经授权可设置为 2。
OFFLINE_AUDIT_OSS_AUDIT_WORKERS=1
OFFLINE_AUDIT_OSS_ALLOWED_HOSTS=xiaokuo-dingding-xianxiahexiao.oss-cn-shenzhen.aliyuncs.com,oss-cn-shenzhen.aliyuncs.com
OFFLINE_AUDIT_OSS_PRODUCER_MODEL=ppio
OFFLINE_AUDIT_OSS_CALLBACK_URL=
OFFLINE_AUDIT_OSS_ALLOW_HTTP_CALLBACK=0
OFFLINE_AUDIT_OSS_NO_CALLBACK=0
OFFLINE_AUDIT_OSS_RECEIVE_ONLY=0
OFFLINE_AUDIT_DEMO=0
