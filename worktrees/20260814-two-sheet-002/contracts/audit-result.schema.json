{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/offline-activity-audit/audit-result.schema.json",
  "title": "Offline activity audit result",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "scenario",
    "case_id",
    "case_name",
    "summary",
    "exceptions"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "scenario": {"enum": ["personnel_incentive", "promotional_display"]},
    "case_id": {"type": "string", "minLength": 1},
    "case_name": {"type": "string", "minLength": 1},
    "summary": {
      "type": "object",
      "required": [
        "conclusion",
        "claimed_amount",
        "suggested_approved_amount",
        "temporarily_held_amount",
        "high_exception_count",
        "medium_exception_count"
      ],
      "properties": {
        "conclusion": {
          "enum": ["pass", "conditional_pass", "partial_pass", "human_review"]
        },
        "claimed_amount": {"type": "number", "minimum": 0},
        "suggested_approved_amount": {"type": "number", "minimum": 0},
        "temporarily_held_amount": {"type": "number", "minimum": 0},
        "high_exception_count": {"type": "integer", "minimum": 0},
        "medium_exception_count": {"type": "integer", "minimum": 0}
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "code", "message", "impact", "suggestion"],
        "properties": {
          "severity": {"enum": ["high", "medium", "low"]},
          "code": {"type": "string", "minLength": 1},
          "message": {"type": "string", "minLength": 1},
          "impact": {"type": "string", "minLength": 1},
          "suggestion": {"type": "string", "minLength": 1},
          "source": {"type": "string"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"scenario": {"const": "personnel_incentive"}}},
      "then": {
        "required": [
          "settlement",
          "sales",
          "sku_reconciliation",
          "sales_trace",
          "store_transfer_reconciliation",
          "transfer_evidence"
        ],
        "properties": {
          "summary": {
            "required": [
              "settlement_line_quantity",
              "excel_mapped_quantity",
              "quantity_difference",
              "settlement_line_reward",
              "transfer_total",
              "quantity_supported_reward",
              "settlement_line_count",
              "matched_sku_count",
              "quantity_match_count",
              "excel_detail_row_count",
              "store_count"
            ]
          },
          "sku_reconciliation": {"type": "array", "minItems": 1},
          "sales_trace": {"type": "array", "minItems": 1},
          "store_transfer_reconciliation": {"type": "array", "minItems": 1},
          "transfer_evidence": {"type": "array"}
        }
      }
    },
    {
      "if": {"properties": {"scenario": {"const": "promotional_display"}}},
      "then": {
        "required": [
          "contract",
          "contract_pdf",
          "sales",
          "photo_inventory",
          "store_reconciliation"
        ],
        "properties": {
          "summary": {
            "required": [
              "contract_store_count",
              "fee_per_store",
              "expected_contract_amount",
              "passed_store_count",
              "supplement_store_count",
              "supported_amount",
              "photo_count",
              "sales_sku_count",
              "sales_quantity"
            ]
          },
          "store_reconciliation": {"type": "array", "minItems": 1}
        }
      }
    }
  ]
}
