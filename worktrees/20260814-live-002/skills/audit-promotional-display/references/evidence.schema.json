{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/audit-promotional-display/evidence.schema.json",
  "title": "Promotional display extracted evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenario", "contract", "photo_reviews"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "scenario": {"const": "promotional_display"},
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_file",
        "customer_name",
        "activity_start",
        "activity_end",
        "display_standard",
        "fee_per_store",
        "claimed_amount",
        "stores"
      ],
      "properties": {
        "source_file": {"type": "string", "minLength": 1},
        "customer_name": {"type": "string", "minLength": 1},
        "activity_start": {"type": "string", "format": "date"},
        "activity_end": {"type": "string", "format": "date"},
        "display_standard": {"type": "string", "minLength": 1},
        "fee_per_store": {"type": "number", "minimum": 0},
        "claimed_amount": {"type": "number", "minimum": 0},
        "seal_visible": {"type": ["boolean", "null"]},
        "stores": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["line_no", "store_name"],
            "properties": {
              "line_no": {"type": "integer", "minimum": 1},
              "store_name": {"type": "string", "minLength": 1},
              "address": {"type": ["string", "null"]}
            }
          }
        },
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "photo_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "store_line_no",
          "contract_store_name",
          "photo_files",
          "visible_date",
          "visible_location",
          "period_match",
          "store_match",
          "display_match",
          "duplicate_check",
          "risk_notes",
          "supplement_advice"
        ],
        "properties": {
          "store_line_no": {"type": "integer", "minimum": 1},
          "contract_store_name": {"type": "string", "minLength": 1},
          "photo_files": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "visible_date": {"type": ["string", "null"], "format": "date"},
          "visible_location": {"type": ["string", "null"]},
          "period_match": {"enum": ["match", "mismatch", "unverifiable"]},
          "store_match": {"enum": ["exact", "compatible", "mismatch", "filename_only"]},
          "display_match": {"enum": ["pass", "fail", "uncertain"]},
          "duplicate_check": {"enum": ["none", "exact", "possible", "unverifiable"]},
          "mapping_basis": {"type": ["string", "null"]},
          "risk_notes": {"type": "array", "items": {"type": "string"}},
          "supplement_advice": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "extraction_notes": {"type": "array", "items": {"type": "string"}}
  }
}
