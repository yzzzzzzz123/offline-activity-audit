{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/audit-personnel-incentive/evidence.schema.json",
  "title": "Personnel incentive extracted evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenario", "settlement", "transfers"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "scenario": {"const": "personnel_incentive"},
    "settlement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_file",
        "customer_name",
        "activity_start",
        "activity_end",
        "claimed_amount",
        "declared_total_quantity",
        "declared_total_reward",
        "lines"
      ],
      "properties": {
        "source_file": {"type": "string", "minLength": 1},
        "customer_name": {"type": "string", "minLength": 1},
        "activity_start": {"type": "string", "format": "date"},
        "activity_end": {"type": "string", "format": "date"},
        "claimed_amount": {"type": "number", "minimum": 0},
        "declared_total_quantity": {"type": "number", "minimum": 0},
        "declared_total_reward": {"type": "number", "minimum": 0},
        "seal_visible": {"type": ["boolean", "null"]},
        "signed_date": {"type": ["string", "null"], "format": "date"},
        "notes": {"type": "array", "items": {"type": "string"}},
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "line_no",
              "product_name",
              "quantity",
              "unit_reward",
              "reward_amount",
              "sales_match"
            ],
            "properties": {
              "line_no": {"type": "integer", "minimum": 1},
              "product_name": {"type": "string", "minLength": 1},
              "quantity": {"type": "number", "minimum": 0},
              "unit_reward": {"type": "number", "minimum": 0},
              "reward_amount": {"type": "number", "minimum": 0},
              "sales_match": {
                "type": "object",
                "additionalProperties": false,
                "required": ["barcode", "basis", "confidence"],
                "properties": {
                  "barcode": {"type": ["string", "null"]},
                  "excel_product_name": {"type": ["string", "null"]},
                  "basis": {"type": "string", "minLength": 1},
                  "confidence": {"enum": ["high", "medium", "low", "ambiguous"]}
                }
              },
              "notes": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "transfers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "transfer_id",
          "amount",
          "occurrence_count",
          "identity_visible",
          "event_date_visible",
          "source_files",
          "dedup_basis"
        ],
        "properties": {
          "transfer_id": {"type": "string", "minLength": 1},
          "amount": {"type": "number", "minimum": 0},
          "occurrence_count": {"type": "integer", "minimum": 1},
          "identity_visible": {"type": "boolean"},
          "event_date_visible": {"type": "boolean"},
          "store_name": {"type": ["string", "null"]},
          "recipient_name": {"type": ["string", "null"]},
          "transfer_date": {"type": ["string", "null"], "format": "date"},
          "source_files": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "dedup_basis": {"type": "string", "minLength": 1},
          "notes": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "extraction_notes": {"type": "array", "items": {"type": "string"}}
  }
}
