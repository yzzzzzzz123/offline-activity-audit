{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rule_id": {
            "type": "string",
            "enum": [
              "pos_fields",
              "pos_arithmetic",
              "pos_product_identity",
              "settlement_seal",
              "settlement_dealer",
              "settlement_activity_dates",
              "settlement_application_dates",
              "contract_signed",
              "contract_dealer",
              "contract_budget_amount",
              "contract_activity_dates",
              "pos_seal",
              "pos_dealer",
              "pos_sales_amount",
              "target_reward",
              "claim_ceiling",
              "stamped_document_pdf",
              "pos_activity_dates"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "unknown",
              "not_applicable"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "description": "给客户看的简短结论：直接说哪个对象有什么问题。通过项建议120字以内，问题或无法确认项建议480字以内；不复述核对过程、候选名单和已通过内容。必要原值与差异保留，完整引用和算式写在对应证据字段。字数只作写法引导，不是审核失败或资料缺失的依据。"
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "comparisons": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "value_kind": {
                  "type": "string",
                  "enum": [
                    "amount",
                    "quantity",
                    "unit_price"
                  ]
                },
                "left": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "unit_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1
                    },
                    "number": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "unit_id",
                    "quote",
                    "number"
                  ]
                },
                "right": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "unit_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1
                      },
                      "number": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "unit_id",
                      "quote",
                      "number"
                    ]
                  }
                },
                "operation": {
                  "type": "string",
                  "enum": [
                    "value",
                    "sum",
                    "product",
                    "ratio",
                    "floor_ratio"
                  ]
                },
                "operator": {
                  "type": "string",
                  "enum": [
                    "eq",
                    "le",
                    "ge"
                  ]
                }
              },
              "required": [
                "label",
                "value_kind",
                "left",
                "right",
                "operation",
                "operator"
              ],
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "operation": {
                        "const": "value"
                      }
                    },
                    "required": [
                      "operation"
                    ]
                  },
                  "then": {
                    "properties": {
                      "right": {
                        "maxItems": 1,
                        "description": "直接比较每次只对应一个原值；多个来源须分别列出比较，不改为求和或任意只取一个。"
                      }
                    }
                  }
                }
              ]
            }
          },
          "reference_evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "written_name",
              "seal_name",
              "periods"
            ],
            "properties": {
              "written_name": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "unit_id",
                      "quote",
                      "value"
                    ],
                    "properties": {
                      "unit_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1
                      },
                      "value": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "seal_name": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "unit_id",
                      "quote",
                      "value"
                    ],
                    "properties": {
                      "unit_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1
                      },
                      "value": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "periods": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "unit_id",
                    "quote"
                  ],
                  "properties": {
                    "unit_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        },
        "required": [
          "rule_id",
          "status",
          "reason",
          "source_ids",
          "comparisons"
        ]
      },
      "minItems": 18,
      "maxItems": 18
    },
    "tool_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool",
          "rule_ids",
          "fields"
        ],
        "properties": {
          "tool": {
            "type": "string",
            "enum": [
              "reference_fields",
              "linked_application_amounts",
              "pos_calculation",
              "source_inventory",
              "activity_periods",
              "pos_field_inventory",
              "pos_matrix_identity",
              "pos_product_lookup",
              "case_python",
              "project_source"
            ]
          },
          "code": {
            "type": "string"
          },
          "source_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "products": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "rule_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "fields": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "advance_dealer",
                "activity_period",
                "application_quantity",
                "application_unit_price",
                "application_products",
                "application_total",
                "approved_total"
              ]
            }
          }
        }
      }
    },
    "reference_reads": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "field": {
            "type": "string",
            "enum": [
              "advance_dealer",
              "activity_period",
              "application_quantity",
              "application_unit_price",
              "application_products",
              "application_total",
              "approved_total"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "available",
              "multiple",
              "missing",
              "empty",
              "incomplete",
              "invalid"
            ]
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "field",
          "state",
          "source_ids"
        ]
      }
    },
    "target_tiers": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sales": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "unit_id": {
                  "type": "string",
                  "minLength": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                },
                "number": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "unit_id",
                "quote",
                "number"
              ]
            },
            "reward": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "unit_id": {
                  "type": "string",
                  "minLength": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                },
                "number": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "unit_id",
                "quote",
                "number"
              ]
            },
            "tiers": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "threshold": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "unit_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1
                      },
                      "number": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "unit_id",
                      "quote",
                      "number"
                    ]
                  },
                  "rate": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "unit_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1
                      },
                      "number": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "unit_id",
                      "quote",
                      "number"
                    ]
                  },
                  "rate_unit": {
                    "type": "string",
                    "enum": [
                      "percent",
                      "ratio"
                    ]
                  }
                },
                "required": [
                  "threshold",
                  "rate",
                  "rate_unit"
                ]
              }
            },
            "complete": {
              "type": "boolean"
            }
          },
          "required": [
            "sales",
            "reward",
            "tiers",
            "complete"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "checks",
    "target_tiers"
  ]
}
