{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/new-product-onboarding-rag-workflow/observation-manifest.schema.json",
  "title": "New product visual observation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observations"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_folder", "source_id", "brand", "observed_product_name",
          "observed_specification", "observed_variant", "barcode_69",
          "name_evidence_files", "barcode_evidence_files"
        ],
        "properties": {
          "source_folder": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^/\\\\]+$"
          },
          "source_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"
          },
          "brand": {"type": "string", "minLength": 1},
          "observed_product_name": {"type": "string", "minLength": 1},
          "observed_specification": {"type": "string", "minLength": 1},
          "observed_variant": {"type": ["string", "null"]},
          "barcode_69": {"type": "string", "pattern": "^69[0-9]{11}$"},
          "name_evidence_files": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$"}
          },
          "barcode_evidence_files": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$"}
          },
          "approved_product_code": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          }
        }
      }
    }
  }
}
