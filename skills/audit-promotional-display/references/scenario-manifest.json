{
  "schema_version": "2.0",
  "scenario_id": "promotional_display",
  "skill_name": "audit-promotional-display",
  "display_name": "陈列堆头",
  "scope": "地堆、陈列、专架、端架",
  "policy_version": "2026-09-18.pdf.3",
  "classification_policy": "material_content",
  "label": "陈列堆头",
  "materials": [
    {
      "id": "display_photos",
      "text": "活动期间带地址、拍摄时间水印的照片，清晰展示全貌、产品摆放、促销标识",
      "when": "always"
    },
    {
      "id": "atrium_agreement",
      "text": "商场中庭大型活动现场展示的商场入场协议（仅大型活动现场需要）",
      "when": "atrium"
    },
    {
      "id": "settlement",
      "text": "结算单（公司统一模板，客户盖章）",
      "when": "always"
    },
    {
      "id": "promotion_contract",
      "text": "签章后的促销合同",
      "when": "always"
    }
  ],
  "audit_points": [
    {
      "id": "submission_deadline",
      "text": "核销自活动结束日起3个月内提交，超期不再核销。月份按日历月；必须有真实活动结束与提交日期，不能拿文件名或分析日期代替。进场费按原文“无时间要求”不作活动时限拒付，仍检查水印日期是否存在。",
      "effect": "reject",
      "when": "activity_deadline",
      "numeric": false
    },
    {
      "id": "review_deadline",
      "text": "财务一审已超2个月且资料有误或缺失，不再补，直接0核销；只有同时具备时间和错误/缺失证据才触发。起算事件不清不能猜测。",
      "effect": "zero",
      "when": "always",
      "numeric": false
    },
    {
      "id": "scene_authenticity",
      "text": "确保费用场景真实；张冠李戴不予核销，额度不返还。仅有模糊或读不清不能认定张冠李戴。",
      "effect": "reject",
      "when": "always",
      "numeric": false
    },
    {
      "id": "fraud",
      "text": "有充分证据确认核销造假时0核销并记录罚款要求（先费用池后经销商额度）；不推测造假，不执行罚款、扣款或通知。",
      "effect": "zero",
      "when": "always",
      "numeric": false
    },
    {
      "id": "bi_quota",
      "text": "BI额度不足不允许先做活动后补申请；以业务发生时的额度与申请、活动时间证据判断，不能用当前余额代替。",
      "effect": "reject",
      "when": "always",
      "numeric": false
    },
    {
      "id": "settlement_template_seal",
      "text": "结算单须为公司统一模板并由客户盖章。",
      "effect": "missing_material",
      "when": "always",
      "numeric": false
    },
    {
      "id": "contract_signed",
      "text": "促销合同已签章。",
      "effect": "missing_material",
      "when": "always",
      "numeric": false
    },
    {
      "id": "pos_fields",
      "text": "POS必含5+2：活动时间、SKU/69码、商品名称、销售数量、销售单价、销售金额、销售金额及数量合计；缺项即不完整。",
      "effect": "missing_material",
      "when": "uses_pos",
      "numeric": false
    },
    {
      "id": "pos_seal",
      "text": "要求提交的POS数据有经销商盖章。",
      "effect": "missing_material",
      "when": "required_pos",
      "numeric": false
    },
    {
      "id": "pos_arithmetic",
      "text": "销售金额=数量×销售单价，并核对销售金额、数量合计。",
      "effect": "missing_material",
      "when": "uses_pos",
      "numeric": true
    },
    {
      "id": "application_quantity_price",
      "text": "数量、单价与申请不符或填错，直接0核销。必须区分销售单价与奖励/补差单价，不把实际销量低于计划自行解释为填错；比较口径不清记无法核验。",
      "effect": "zero",
      "when": "uses_pos",
      "numeric": true
    },
    {
      "id": "display_watermark",
      "text": "照片拍摄日期在执行周期内，地址与活动门店一致，日期和地址缺一即不完整。",
      "effect": "missing_material",
      "when": "always",
      "numeric": false
    },
    {
      "id": "display_brand",
      "text": "申请的堆头或陈列大小范围内只能存在参半品牌，不能有其他产品；不得把申请区域外相邻货架算为混摆。",
      "effect": "missing_material",
      "when": "always",
      "numeric": false
    },
    {
      "id": "display_material_brand",
      "text": "堆头陈列物料元素为小阔集团产品（参半、重点、小箭头）。",
      "effect": "missing_material",
      "when": "always",
      "numeric": false
    },
    {
      "id": "atrium_agreement",
      "text": "商场中庭大型活动现场展示有商场入场协议；没有则缺资料。仅大型活动现场要求此项。",
      "effect": "missing_material",
      "when": "atrium",
      "numeric": false
    },
    {
      "id": "display_quantity_price",
      "text": "数量、单价等明细与申请填错，直接0核销。",
      "effect": "zero",
      "when": "always",
      "numeric": true
    },
    {
      "id": "display_size",
      "text": "按照申请的堆头大小与现场照片判断是否符合；没有可用规格或尺度时明确无法核验，不使用旧固定面积、列数标准。",
      "effect": "missing_material",
      "when": "always",
      "numeric": false
    }
  ]
}
