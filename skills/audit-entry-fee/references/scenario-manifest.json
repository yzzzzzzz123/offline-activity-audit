{
  "schema_version": "2.0",
  "scenario_id": "entry_fee",
  "skill_name": "audit-entry-fee",
  "display_name": "进场费",
  "scope": "进场费、条码费（无时间要求）",
  "policy_version": "2026-09-18.pdf.3",
  "classification_policy": "material_content",
  "label": "进场费",
  "materials": [
    {
      "id": "entry_agreement",
      "text": "产品推广协议（公司统一标准模板，双方盖章）",
      "when": "always"
    },
    {
      "id": "entry_system",
      "text": "带公司进场产品的 POS 或终端库存表（适用于 CVS/OTC 渠道）",
      "when": "cvs_otc"
    },
    {
      "id": "shelf_photos",
      "text": "日期、地址、店名水印照片，清晰可辨具体 SKU",
      "when": "always"
    }
  ],
  "audit_points": [
    {
      "id": "submission_deadline",
      "text": "核销自活动结束日起3个月内提交，超期不再核销。月份按日历月；必须有真实活动结束与提交日期，不能拿文件名或分析日期代替。进场费按原文“无时间要求”不作活动时限拒付，仍检查水印日期是否存在。",
      "effect": "reject",
      "when": "activity_deadline",
      "numeric": false
    },
    {
      "id": "review_deadline",
      "text": "财务一审已超2个月且资料有误或缺失，不再补，直接0核销；只有同时具备时间和错误/缺失证据才触发。起算事件不清不能猜测。",
      "effect": "zero",
      "when": "always",
      "numeric": false
    },
    {
      "id": "scene_authenticity",
      "text": "确保费用场景真实；张冠李戴不予核销，额度不返还。仅有模糊或读不清不能认定张冠李戴。",
      "effect": "reject",
      "when": "always",
      "numeric": false
    },
    {
      "id": "fraud",
      "text": "有充分证据确认核销造假时0核销并记录罚款要求（先费用池后经销商额度）；不推测造假，不执行罚款、扣款或通知。",
      "effect": "zero",
      "when": "always",
      "numeric": false
    },
    {
      "id": "bi_quota",
      "text": "BI额度不足不允许先做活动后补申请；以业务发生时的额度与申请、活动时间证据判断，不能用当前余额代替。",
      "effect": "reject",
      "when": "always",
      "numeric": false
    },
    {
      "id": "pos_fields",
      "text": "POS必含5+2：活动时间、SKU/69码、商品名称、销售数量、销售单价、销售金额、销售金额及数量合计；缺项即不完整。",
      "effect": "missing_material",
      "when": "uses_pos",
      "numeric": false
    },
    {
      "id": "pos_seal",
      "text": "要求提交的POS数据有经销商盖章。",
      "effect": "missing_material",
      "when": "required_pos",
      "numeric": false
    },
    {
      "id": "pos_arithmetic",
      "text": "销售金额=数量×销售单价，并核对销售金额、数量合计。",
      "effect": "missing_material",
      "when": "uses_pos",
      "numeric": true
    },
    {
      "id": "application_quantity_price",
      "text": "数量、单价与申请不符或填错，直接0核销。必须区分销售单价与奖励/补差单价，不把实际销量低于计划自行解释为填错；比较口径不清记无法核验。",
      "effect": "zero",
      "when": "uses_pos",
      "numeric": true
    },
    {
      "id": "entry_agreement",
      "text": "产品推广协议为公司统一标准模板且双方盖章，否则缺资料。",
      "effect": "missing_material",
      "when": "always",
      "numeric": false
    },
    {
      "id": "entry_sku",
      "text": "水印照片清晰可辨具体SKU，并与活动申请一致；无法辨识则缺资料。",
      "effect": "missing_material",
      "when": "always",
      "numeric": false
    },
    {
      "id": "entry_watermark",
      "text": "水印包含日期、地址、店名，门店地址一致。原文无时间要求，不额外要求照片处于活动周期。",
      "effect": "missing_material",
      "when": "always",
      "numeric": false
    },
    {
      "id": "entry_system",
      "text": "CVS/OTC渠道系统性资料含公司进场产品的POS或终端库存表。",
      "effect": "missing_material",
      "when": "cvs_otc",
      "numeric": false
    },
    {
      "id": "entry_duplicate",
      "text": "存量进场记录检查是否重复；只在具有历史业务依据时判断，不凭同商品多店上架认定重复。",
      "effect": "missing_material",
      "when": "always",
      "numeric": false
    }
  ]
}
