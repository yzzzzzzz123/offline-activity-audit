{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/audit-personnel-incentive/evidence.schema.json",
  "title": "Personnel incentive visual evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenario", "settlement", "transfers", "extraction_notes"],
  "properties": {
    "schema_version": {"type": "string", "const": "2.0"},
    "scenario": {"type": "string", "const": "personnel_incentive"},
    "settlement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_file", "customer_name", "activity_start", "activity_end",
        "claimed_amount", "declared_total_quantity", "declared_total_reward",
        "seal_visible", "signed_date", "notes", "lines"
      ],
      "properties": {
        "source_file": {"type": "string", "minLength": 1},
        "customer_name": {"type": "string", "minLength": 1},
        "activity_start": {"type": "string", "format": "date"},
        "activity_end": {"type": "string", "format": "date"},
        "claimed_amount": {"type": "number", "minimum": 0},
        "declared_total_quantity": {"type": "number", "minimum": 0},
        "declared_total_reward": {"type": "number", "minimum": 0},
        "seal_visible": {"type": ["boolean", "null"]},
        "signed_date": {"type": ["string", "null"], "format": "date"},
        "notes": {"type": "array", "items": {"type": "string"}},
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "line_no", "product_name", "barcode_visible", "quantity",
              "unit_reward", "reward_amount", "notes"
            ],
            "properties": {
              "line_no": {"type": "integer", "minimum": 1},
              "product_name": {"type": "string", "minLength": 1},
              "barcode_visible": {"type": ["string", "null"]},
              "quantity": {"type": "number", "minimum": 0},
              "unit_reward": {"type": "number", "minimum": 0},
              "reward_amount": {"type": "number", "minimum": 0},
              "notes": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "transfers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "transfer_id", "amount", "occurrence_count", "identity_visible",
          "event_date_visible", "store_name", "recipient_name", "transfer_date",
          "source_files", "dedup_basis", "notes"
        ],
        "properties": {
          "transfer_id": {"type": "string", "minLength": 1},
          "amount": {"type": "number", "minimum": 0},
          "occurrence_count": {"type": "integer", "minimum": 1},
          "identity_visible": {"type": "boolean"},
          "event_date_visible": {"type": "boolean"},
          "store_name": {"type": ["string", "null"]},
          "recipient_name": {"type": ["string", "null"]},
          "transfer_date": {"type": ["string", "null"], "format": "date"},
          "source_files": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "dedup_basis": {"type": "string", "minLength": 1},
          "notes": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "extraction_notes": {"type": "array", "items": {"type": "string"}}
  }
}
