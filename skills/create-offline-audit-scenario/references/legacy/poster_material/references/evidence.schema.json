{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/offline-activity-audit/poster-material-evidence.schema.json",
  "title": "Poster and material-production visible evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario",
    "contract",
    "invoice_receipt",
    "settlement",
    "field_photos",
    "extraction_notes"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "scenario": {"type": "string", "const": "poster_material"},
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_file",
        "project_name",
        "customer_name",
        "activity_budget",
        "activity_start",
        "activity_end",
        "store_count",
        "item_requirements",
        "referenced_attachment",
        "customer_seal_visible",
        "signing_date",
        "limitations"
      ],
      "properties": {
        "source_file": {"type": "string", "minLength": 1},
        "project_name": {"type": ["string", "null"]},
        "customer_name": {"type": ["string", "null"]},
        "activity_budget": {"type": ["number", "null"], "minimum": 0},
        "activity_start": {"type": ["string", "null"], "format": "date"},
        "activity_end": {"type": ["string", "null"], "format": "date"},
        "store_count": {"type": ["integer", "null"], "minimum": 0},
        "item_requirements": {
          "type": "array",
          "items": {"$ref": "#/$defs/material_line"}
        },
        "referenced_attachment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mentioned", "description"],
          "properties": {
            "mentioned": {"type": "boolean"},
            "description": {"type": ["string", "null"]}
          }
        },
        "customer_seal_visible": {"$ref": "#/$defs/visibility"},
        "signing_date": {"type": ["string", "null"], "format": "date"},
        "limitations": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "invoice_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_file",
        "document_type",
        "title_name",
        "issue_date",
        "line_items",
        "total_amount",
        "issuer_name",
        "issuer_stamp_visible",
        "limitations"
      ],
      "properties": {
        "source_file": {"type": "string", "minLength": 1},
        "document_type": {
          "type": "string",
          "enum": ["invoice", "receipt", "other"]
        },
        "title_name": {"type": ["string", "null"]},
        "issue_date": {"type": ["string", "null"], "format": "date"},
        "line_items": {
          "type": "array",
          "items": {"$ref": "#/$defs/material_line"}
        },
        "total_amount": {"type": ["number", "null"], "minimum": 0},
        "issuer_name": {"type": ["string", "null"]},
        "issuer_stamp_visible": {"$ref": "#/$defs/visibility"},
        "limitations": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "settlement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_file",
        "template_title",
        "payee_company",
        "customer_name",
        "activity_start",
        "activity_end",
        "line_items",
        "total_amount",
        "settlement_date",
        "customer_seal_visible",
        "limitations"
      ],
      "properties": {
        "source_file": {"type": "string", "minLength": 1},
        "template_title": {"type": ["string", "null"]},
        "payee_company": {"type": ["string", "null"]},
        "customer_name": {"type": ["string", "null"]},
        "activity_start": {"type": ["string", "null"], "format": "date"},
        "activity_end": {"type": ["string", "null"], "format": "date"},
        "line_items": {
          "type": "array",
          "items": {"$ref": "#/$defs/material_line"}
        },
        "total_amount": {"type": ["number", "null"], "minimum": 0},
        "settlement_date": {"type": ["string", "null"], "format": "date"},
        "customer_seal_visible": {"$ref": "#/$defs/visibility"},
        "limitations": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "field_photos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_file",
          "watermark_date",
          "watermark_time",
          "watermark_location",
          "date_visibility",
          "time_visibility",
          "location_visibility",
          "observed_materials",
          "content_summary",
          "finished_effect_visible",
          "display_position",
          "display_position_visible",
          "dimension_text",
          "dimension_evidence",
          "limitations"
        ],
        "properties": {
          "source_file": {"type": "string", "minLength": 1},
          "watermark_date": {"type": ["string", "null"], "format": "date"},
          "watermark_time": {
            "type": ["string", "null"],
            "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9](?::[0-5][0-9])?$"
          },
          "watermark_location": {"type": ["string", "null"]},
          "date_visibility": {"$ref": "#/$defs/visibility"},
          "time_visibility": {"$ref": "#/$defs/visibility"},
          "location_visibility": {"$ref": "#/$defs/visibility"},
          "observed_materials": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["item_type", "visible_unit_count", "basis"],
              "properties": {
                "item_type": {"$ref": "#/$defs/material_type"},
                "visible_unit_count": {"type": ["integer", "null"], "minimum": 0},
                "basis": {"type": "string", "minLength": 1}
              }
            }
          },
          "content_summary": {"type": "string", "minLength": 1},
          "finished_effect_visible": {"$ref": "#/$defs/visibility"},
          "display_position": {"type": ["string", "null"]},
          "display_position_visible": {"$ref": "#/$defs/visibility"},
          "dimension_text": {"type": ["string", "null"]},
          "dimension_evidence": {"$ref": "#/$defs/visibility"},
          "limitations": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "extraction_notes": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "visibility": {
      "type": "string",
      "enum": ["visible", "not_visible", "unclear"]
    },
    "material_type": {
      "type": "string",
      "enum": ["lightbox", "counter_display", "poster", "shelf_card", "standee", "other"]
    },
    "material_line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_type",
        "description",
        "quantity",
        "unit_price",
        "subtotal"
      ],
      "properties": {
        "item_type": {"$ref": "#/$defs/material_type"},
        "description": {"type": "string", "minLength": 1},
        "quantity": {"type": ["number", "null"], "minimum": 0},
        "unit_price": {"type": ["number", "null"], "minimum": 0},
        "subtotal": {"type": ["number", "null"], "minimum": 0}
      }
    }
  }
}
