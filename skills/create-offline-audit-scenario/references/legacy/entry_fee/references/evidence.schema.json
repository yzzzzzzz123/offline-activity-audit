{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/offline-activity-audit/entry-fee-evidence.schema.json",
  "title": "Entry-fee visible evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenario", "documents", "extraction_notes"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "scenario": {"type": "string", "const": "entry_fee"},
    "documents": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/document"}},
    "extraction_notes": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "visibility": {"type": "string", "enum": ["visible", "not_visible", "unclear", "not_applicable"]},
    "contract_item": {
      "type": "object", "additionalProperties": false,
      "required": ["line_no", "product_code", "product_name", "contracted_store_count", "barcode_fee"],
      "properties": {
        "line_no": {"type": "integer", "minimum": 1},
        "product_code": {"type": ["string", "null"], "minLength": 1},
        "product_name": {"type": ["string", "null"], "minLength": 1},
        "contracted_store_count": {"type": ["integer", "null"], "minimum": 0},
        "barcode_fee": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "contract_store": {
      "type": "object", "additionalProperties": false,
      "required": ["line_no", "store_name", "terminal_system", "store_type", "full_address"],
      "properties": {
        "line_no": {"type": "integer", "minimum": 1},
        "store_name": {"type": ["string", "null"], "minLength": 1},
        "terminal_system": {"type": ["string", "null"], "minLength": 1},
        "store_type": {"type": ["string", "null"], "minLength": 1},
        "full_address": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "visible_product": {
      "type": "object", "additionalProperties": false,
      "required": ["product_code", "product_name", "visible_package_text"],
      "properties": {
        "product_code": {"type": ["string", "null"], "minLength": 1},
        "product_name": {"type": ["string", "null"], "minLength": 1},
        "visible_package_text": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "document": {
      "type": "object", "additionalProperties": false,
      "required": [
        "source_file", "role", "document_type", "title", "party_names", "party_a", "party_b",
        "agreement_date", "agreement_year", "terminal_system", "terminal_type", "signed_visible",
        "party_a_seal_visible", "party_b_seal_visible", "contract_items", "contract_stores",
        "contract_total_amount", "tax_included_visible", "payment_method",
        "per_order_deduction_rate_cap", "actual_shelving_only_visible",
        "shelf_photos_required_visible", "system_deduction_proof_required_visible",
        "new_store_cost_dealer_visible", "photo_date", "photo_time", "photo_location",
        "photo_store_name", "watermark_date_visible", "watermark_time_visible",
        "watermark_address_visible", "shelf_display_visible", "visible_products",
        "deduction_date", "deduction_subject", "deduction_amount", "deduction_proof_visible",
        "visible_summary", "limitations"
      ],
      "properties": {
        "source_file": {"type": "string", "minLength": 1},
        "role": {"type": "string", "enum": ["entry_fee_contract", "shelf_photo", "system_deduction_proof", "other"]},
        "document_type": {"type": "string", "minLength": 1},
        "title": {"type": ["string", "null"], "minLength": 1},
        "party_names": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "party_a": {"type": ["string", "null"], "minLength": 1},
        "party_b": {"type": ["string", "null"], "minLength": 1},
        "agreement_date": {"type": ["string", "null"], "format": "date"},
        "agreement_year": {"type": ["integer", "null"], "minimum": 2000, "maximum": 2100},
        "terminal_system": {"type": ["string", "null"], "minLength": 1},
        "terminal_type": {"type": ["string", "null"], "minLength": 1},
        "signed_visible": {"$ref": "#/$defs/visibility"},
        "party_a_seal_visible": {"$ref": "#/$defs/visibility"},
        "party_b_seal_visible": {"$ref": "#/$defs/visibility"},
        "contract_items": {"type": "array", "items": {"$ref": "#/$defs/contract_item"}},
        "contract_stores": {"type": "array", "items": {"$ref": "#/$defs/contract_store"}},
        "contract_total_amount": {"type": ["number", "null"], "minimum": 0},
        "tax_included_visible": {"$ref": "#/$defs/visibility"},
        "payment_method": {"type": ["string", "null"], "minLength": 1},
        "per_order_deduction_rate_cap": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "actual_shelving_only_visible": {"$ref": "#/$defs/visibility"},
        "shelf_photos_required_visible": {"$ref": "#/$defs/visibility"},
        "system_deduction_proof_required_visible": {"$ref": "#/$defs/visibility"},
        "new_store_cost_dealer_visible": {"$ref": "#/$defs/visibility"},
        "photo_date": {"type": ["string", "null"], "format": "date"},
        "photo_time": {"type": ["string", "null"], "minLength": 1},
        "photo_location": {"type": ["string", "null"], "minLength": 1},
        "photo_store_name": {"type": ["string", "null"], "minLength": 1},
        "watermark_date_visible": {"$ref": "#/$defs/visibility"},
        "watermark_time_visible": {"$ref": "#/$defs/visibility"},
        "watermark_address_visible": {"$ref": "#/$defs/visibility"},
        "shelf_display_visible": {"$ref": "#/$defs/visibility"},
        "visible_products": {"type": "array", "items": {"$ref": "#/$defs/visible_product"}},
        "deduction_date": {"type": ["string", "null"], "format": "date"},
        "deduction_subject": {"type": ["string", "null"], "minLength": 1},
        "deduction_amount": {"type": ["number", "null"], "minimum": 0},
        "deduction_proof_visible": {"$ref": "#/$defs/visibility"},
        "visible_summary": {"type": "string", "minLength": 1},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
