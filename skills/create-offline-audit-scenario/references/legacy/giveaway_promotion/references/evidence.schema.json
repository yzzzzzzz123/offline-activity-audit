{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/offline-activity-audit/giveaway-promotion-evidence.schema.json",
  "title": "Extra-giveaway visible evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenario", "documents", "extraction_notes"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "scenario": {"type": "string", "const": "giveaway_promotion"},
    "documents": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/document"}},
    "extraction_notes": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "visibility": {
      "type": "string",
      "enum": ["visible", "not_visible", "unclear", "not_applicable"]
    },
    "product_line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line_no", "line_type", "product_code", "barcode_69", "product_name",
        "quantity", "unit", "unit_price", "amount", "line_date", "gift_ratio_text"
      ],
      "properties": {
        "line_no": {"type": "integer", "minimum": 1},
        "line_type": {"type": "string", "enum": ["eligible_sale", "gift", "shipment", "summary", "other"]},
        "product_code": {"type": ["string", "null"], "minLength": 1},
        "barcode_69": {"type": ["string", "null"], "pattern": "^69[0-9]{11}$"},
        "product_name": {"type": "string", "minLength": 1},
        "quantity": {"type": ["number", "null"], "minimum": 0},
        "unit": {"type": ["string", "null"], "minLength": 1},
        "unit_price": {"type": ["number", "null"], "minimum": 0},
        "amount": {"type": ["number", "null"], "minimum": 0},
        "line_date": {"type": ["string", "null"], "format": "date"},
        "gift_ratio_text": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_file", "role", "document_type", "title", "party_names",
        "dealer_name", "store_name", "document_date", "activity_start",
        "activity_end", "fee_type", "signed_visible", "dealer_seal_visible",
        "company_template_visible", "contract_budget", "shipment_amount",
        "claimed_gift_amount", "total_gift_quantity", "gift_unit_price",
        "calculation_text", "gift_ratio_text", "product_lines", "receipt_number",
        "receipt_total_paid", "activity_date", "activity_location",
        "activity_content", "promotion_visible", "visible_summary", "limitations"
      ],
      "properties": {
        "source_file": {"type": "string", "minLength": 1},
        "role": {"type": "string", "const": "visual_document"},
        "document_type": {
          "type": "string",
          "enum": [
            "signed_promotional_contract", "settlement", "sales_delivery_statement",
            "store_receipt", "activity_photo", "supporting_document", "other"
          ]
        },
        "title": {"type": ["string", "null"], "minLength": 1},
        "party_names": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "dealer_name": {"type": ["string", "null"], "minLength": 1},
        "store_name": {"type": ["string", "null"], "minLength": 1},
        "document_date": {"type": ["string", "null"], "format": "date"},
        "activity_start": {"type": ["string", "null"], "format": "date"},
        "activity_end": {"type": ["string", "null"], "format": "date"},
        "fee_type": {"type": ["string", "null"], "minLength": 1},
        "signed_visible": {"$ref": "#/$defs/visibility"},
        "dealer_seal_visible": {"$ref": "#/$defs/visibility"},
        "company_template_visible": {"$ref": "#/$defs/visibility"},
        "contract_budget": {"type": ["number", "null"], "minimum": 0},
        "shipment_amount": {"type": ["number", "null"], "minimum": 0},
        "claimed_gift_amount": {"type": ["number", "null"], "minimum": 0},
        "total_gift_quantity": {"type": ["number", "null"], "minimum": 0},
        "gift_unit_price": {"type": ["number", "null"], "minimum": 0},
        "calculation_text": {"type": ["string", "null"], "minLength": 1},
        "gift_ratio_text": {"type": ["string", "null"], "minLength": 1},
        "product_lines": {"type": "array", "items": {"$ref": "#/$defs/product_line"}},
        "receipt_number": {"type": ["string", "null"], "minLength": 1},
        "receipt_total_paid": {"type": ["number", "null"], "minimum": 0},
        "activity_date": {"type": ["string", "null"], "format": "date"},
        "activity_location": {"type": ["string", "null"], "minLength": 1},
        "activity_content": {"type": ["string", "null"], "minLength": 1},
        "promotion_visible": {"$ref": "#/$defs/visibility"},
        "visible_summary": {"type": "string", "minLength": 1},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
