{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/offline-activity-audit/shared-product-rag-pending.schema.json",
  "title": "Product visual references pending a verified 69 barcode",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pending_products"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "pending_products": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pending_id", "brand", "product_name", "product_code",
          "specification", "variant", "reason", "source", "views"
        ],
        "properties": {
          "pending_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
          "brand": {"type": "string", "minLength": 1},
          "product_name": {"type": "string", "minLength": 1},
          "product_code": {"type": "string", "minLength": 1},
          "specification": {"type": "string", "minLength": 1},
          "variant": {"type": ["string", "null"]},
          "reason": {"type": "string", "minLength": 1},
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_id", "collection", "source_folder",
              "observed_product_name", "observed_specification", "observed_variant"
            ],
            "properties": {
              "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
              "collection": {"type": "string", "minLength": 1},
              "source_folder": {"type": "string", "minLength": 1},
              "observed_product_name": {"type": "string", "minLength": 1},
              "observed_specification": {"type": "string", "minLength": 1},
              "observed_variant": {"type": ["string", "null"]}
            }
          },
          "views": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "view_id", "face", "image_file", "source_original_name",
                "source_id", "source_collection", "source_folder", "sha256",
                "width", "height", "identity_strength", "visible_anchors", "limitations"
              ],
              "properties": {
                "view_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"},
                "face": {"type": "string", "const": "unclassified"},
                "image_file": {"type": "string", "minLength": 1},
                "source_original_name": {"type": "string", "minLength": 1},
                "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"},
                "source_collection": {"type": "string", "minLength": 1},
                "source_folder": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "width": {"type": "integer", "minimum": 1},
                "height": {"type": "integer", "minimum": 1},
                "identity_strength": {"type": "string", "const": "unreviewed"},
                "visible_anchors": {"type": "array", "items": {"type": "string"}},
                "limitations": {
                  "type": "array",
                  "minItems": 1,
                  "items": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        }
      }
    }
  }
}
